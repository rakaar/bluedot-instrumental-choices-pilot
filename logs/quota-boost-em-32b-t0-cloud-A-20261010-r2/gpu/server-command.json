[
  "/workspace/bluedot-ic/inference/.venv/bin/vllm",
  "serve",
  "/workspace/bluedot-ic/models/qwen-control-32b",
  "--served-model-name",
  "qwen-control-32b",
  "--host",
  "127.0.0.1",
  "--port",
  "8000",
  "--dtype",
  "bfloat16",
  "--max-model-len",
  "16384",
  "--max-num-seqs",
  "1",
  "--gpu-memory-utilization",
  "0.90",
  "--enable-auto-tool-choice",
  "--tool-call-parser",
  "hermes",
  "--generation-config",
  "vllm",
  "--api-key",
  "local-ssh-only",
  "--enable-lora",
  "--max-lora-rank",
  "32",
  "--max-loras",
  "1",
  "--lora-dtype",
  "bfloat16",
  "--lora-modules",
  "qwen-em-32b=/workspace/bluedot-ic/models/qwen-em-32b-adapter",
  "--tensor-parallel-size",
  "4"
]
